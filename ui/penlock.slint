import { Dialog } from "@ui/dialog.slint";
import { SlideToConfirm } from "@ui/slide_to_confirm.slint";
import { TextArea } from "@ui/textarea.slint";
import { Callbacks, PenlockScreen, PenlockState, PhraseStatus, ShareRow, WalletState } from "callbacks.slint";
import {
    Action,
    ActionKind,
    Body,
    Caption,
    Code,
    Content,
    Display,
    Eyebrow,
    Footer,
    Heading,
    Icon,
    Icons,
    Label,
    NavCard,
    Note,
    Prime,
    Screen,
    ScreenHeader,
    Title,
} from "common.slint";

// Shown over the home on every launch; nothing is saved, so there's no "seen it" to remember.
export component SeedWarning inherits Rectangle {
    // Dialog only blocks touches on its backdrop when it's dismissable.
    TouchArea { }

    Dialog {
        width: parent.width;
        height: parent.height;
        dismissable: false;
        fill-container: true;
        backdrop-color: Prime.scrim;
        panel-background: Prime.surface-raised;
        panel-border-color: Prime.line;
        panel-padding: 24px;
        border-radius: 24px;

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Prime.copper-soft;

                Icon {
                    source: Icons.shield;
                    tint: Prime.copper-ink;
                }
            }
        }

        Eyebrow {
            text: "BEFORE YOU START";
        }

        Title {
            text: "Protect your seed phrase";
        }

        Body {
            text: "Anyone with your seed phrase can take your funds. Never photograph it, share it, or type it into anything but this Passport.";
        }

        Rectangle {
            border-radius: 8px;
            background: Prime.surface-sunken;
            height: bullets.preferred-height;

            bullets := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Note {
                    icon: Icons.shares;
                    text: "Any two of your three shares rebuild the phrase.";
                    text-color: Prime.ink;
                }

                Note {
                    icon: Icons.pin;
                    text: "Keep each strip in a different place.";
                    text-color: Prime.ink;
                }
            }
        }

        Action {
            height: 52px;
            text: "I understand";
            clicked => {
                PenlockState.warning-accepted = true;
            }
        }
    }
}

// Sits over the home's top corner.
export component SettingsButton {
    width: 48px;
    height: 48px;

    Icon {
        source: Icons.settings;
        tint: Prime.ink-muted;
    }

    TouchArea {
        clicked => {
            PenlockState.screen = PenlockScreen.settings;
        }
    }
}

export component PenlockHome inherits Screen {
    VerticalLayout {
        vertical-stretch: 1;
        padding-top: 40px;
        padding-left: Prime.gutter;
        padding-right: Prime.gutter;
        padding-bottom: 24px;

        Eyebrow {
            text: "2-OF-3 PAPER BACKUP";
        }

        Rectangle {
            height: 8px;
        }

        Display {
            text: "Penlock";
        }

        Rectangle {
            height: 12px;
        }

        Body {
            text: "Split your seed phrase into three paper shares. Any two rebuild it. Runs offline, and nothing is saved unless you export it.";
        }

        Rectangle {
            height: 32px;
        }

        VerticalLayout {
            spacing: 12px;

            NavCard {
                icon: Icons.shares;
                title: "Create shares";
                subtitle: "Split a 12- or 24-word phrase";
                accent: !WalletState.loaded;
                clicked => {
                    Callbacks.penlock-create();
                }
            }

            NavCard {
                icon: Icons.refresh;
                title: "Restore from shares";
                subtitle: "Scan any two strips with the camera";
                clicked => {
                    Callbacks.penlock-scan();
                }
            }

            NavCard {
                icon: Icons.scan-text;
                title: "Read a written phrase";
                subtitle: "Scan your seed phrase off paper";
                clicked => {
                    Callbacks.penlock-read-phrase();
                }
            }
        }

        Rectangle {
            height: 32px;
        }

        Eyebrow {
            text: "SIGNING";
        }

        Rectangle {
            height: 12px;
        }

        NavCard {
            icon: Icons.key;
            title: "Sign a transaction";
            subtitle: "With a seed phrase or Penlock shares";
            accent: WalletState.loaded;
            open-key: WalletState.loaded ? WalletState.fingerprint : "";
            clicked => {
                if WalletState.loaded {
                    Callbacks.wallet-home();
                } else {
                    PenlockState.screen = PenlockScreen.wallet-load;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

// One numbered word on a ruled line, with the line itself marking a bad one.
component WordChip {
    in property <int> number;
    in property <string> word;
    in property <bool> bad;
    height: 32px;

    Rectangle {
        y: 0;
        height: root.bad ? 2px : 1px;
        background: root.bad ? Prime.danger : root.word != "" ? Prime.line-strong : Prime.line;
    }

    HorizontalLayout {
        spacing: 8px;

        Text {
            width: 18px;
            text: root.number;
            color: root.bad ? Prime.danger : Prime.ink-faint;
            font-family: Prime.mono-font;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.word;
            color: root.bad ? Prime.danger : Prime.ink;
            font-family: Prime.text-font;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.bad: VerticalLayout {
            alignment: center;

            Icon {
                source: Icons.alert;
                tint: Prime.danger;
                size: 14px;
            }
        }
    }
}

export component EnterPhrase inherits Screen {
    ScreenHeader {
        title: "Seed phrase";
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        spacing: 8px;

        if PenlockState.phrase-note != "": Rectangle {
            height: read-note.preferred-height;

            Rectangle {
                y: 0;
                height: 2px;
                background: Prime.warning;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Prime.line;
            }

            read-note := HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;

                Icon {
                    source: Icons.alert;
                    tint: Prime.warning;
                    size: 20px;
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    Label {
                        text: "Read from paper.";
                        color: Prime.warning;
                        font-weight: 600;
                    }

                    Label {
                        text: PenlockState.phrase-note;
                        color: Prime.ink;
                    }
                }
            }
        }

        Rectangle {
            height: 8px;
        }

        HorizontalLayout {
            Label {
                horizontal-stretch: 1;
                text: "Seed phrase";
                font-weight: 500;
            }

            Code {
                text: PenlockState.phrase-count == 1 ? "1 word" : "\{PenlockState.phrase-count} words";
                color: Prime.ink-faint;
                font-size: 12px;
            }
        }

        phrase := TextArea {
            vertical-stretch: 0;
            height: 112px;
            field-min-height: 112px;
            disable-autosize: true;
            placeholder: "Type your words, separated by spaces";
            value <=> PenlockState.phrase;
            background: Prime.surface-sunken;
            foreground: Prime.ink;
            placeholder-color: Prime.ink-faint;
            border-color: PenlockState.phrase-status == PhraseStatus.error ? Prime.danger : Prime.line-strong;
            border-width: PenlockState.phrase-status == PhraseStatus.error ? 2px : 1px;
            border-radius: 8px;
            font-family: Prime.text-font;
            font-size: 18px;
            changed(text) => {
                // The open keyboard covers the button, so Done has to close it.
                if Callbacks.phrase-edited(text) {
                    self.clear-focus();
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;

            if PenlockState.phrase-status == PhraseStatus.error: Icon {
                source: Icons.alert;
                tint: Prime.danger;
                size: 16px;
            }

            if PenlockState.phrase-status == PhraseStatus.valid: Icon {
                source: Icons.check;
                tint: Prime.success;
                size: 16px;
            }

            Label {
                horizontal-stretch: 1;
                text: PenlockState.phrase-message;
                color: PenlockState.phrase-status == PhraseStatus.error ? Prime.danger : PenlockState.phrase-status == PhraseStatus.valid ? Prime.success : Prime.ink-faint;
            }
        }

        Rectangle {
            height: 8px;
        }

        // Numbered lines wait for the words, so the layout doesn't move as they arrive.
        if PenlockState.phrase-count == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            spacing: 4px;

            for r in 4: HorizontalLayout {
                spacing: 16px;

                for c in 3: WordChip {
                    width: (root.width - 2 * Prime.gutter - 32px) / 3;
                    number: r * 3 + c + 1;
                }
            }

            Caption {
                text: "Your words appear here, numbered, so you can check each one against your paper.";
            }
        }

        if PenlockState.phrase-count > 0: Flickable {
            vertical-stretch: 1;
            viewport-height: chips.preferred-height;

            chips := VerticalLayout {
                alignment: start;
                spacing: 4px;

                for row in PenlockState.chip-rows: HorizontalLayout {
                    spacing: 16px;

                    for chip in row.chips: WordChip {
                        width: (root.width - 2 * Prime.gutter - 32px) / 3;
                        number: chip.number;
                        word: chip.word;
                        bad: chip.bad;
                    }
                }
            }
        }
    }

    Footer {
        Action {
            text: "Create shares";
            disabled: PenlockState.phrase-status != PhraseStatus.valid;
            clicked => {
                Callbacks.split-phrase(phrase.value);
                phrase.value = "";
            }
        }

        Action {
            kind: ActionKind.secondary;
            text: "Sign a transaction";
            disabled: PenlockState.phrase-status != PhraseStatus.valid;
            clicked => {
                Callbacks.seed-sign(phrase.value);
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Sign with cosigners";
            disabled: PenlockState.phrase-status != PhraseStatus.valid;
            clicked => {
                Callbacks.open-wallet(phrase.value);
            }
        }
    }
}

component SymbolBox inherits Rectangle {
    in property <string> symbol;
    // The worksheet shades the two checksum boxes.
    in property <bool> shaded;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.shaded ? Prime.line-accent : Prime.line-strong;
    background: root.shaded ? Prime.copper-soft : Prime.surface-sunken;

    Text {
        text: root.symbol;
        color: root.shaded ? Prime.copper-ink : Prime.ink;
        font-family: Prime.mono-font;
        font-size: root.size * 0.45;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ShareGrid inherits VerticalLayout {
    in property <[ShareRow]> rows;
    // Which rows to draw, so a long share can run in two columns.
    in property <int> first: 0;
    in property <int> count: root.rows.length;
    in property <length> box: 40px;
    in property <length> gap: 6px;
    alignment: start;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: root.gap;

    for i in root.count: HorizontalLayout {
        alignment: center;
        spacing: root.gap;

        Text {
            width: 24px;
            text: root.first + i + 1;
            color: Prime.ink-faint;
            font-family: Prime.mono-font;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            width: root.gap;
        }

        for c in 2: SymbolBox {
            size: root.box;
            symbol: root.rows[root.first + i].symbols[c];
            shaded: true;
        }

        Rectangle {
            width: root.gap * 2;
        }

        for c in 4: SymbolBox {
            size: root.box;
            symbol: root.rows[root.first + i].symbols[c + 2];
        }
    }
}

// Every row of one share at once, for copying. A tap anywhere goes back.
export component ShareFull inherits Rectangle {
    property <int> share: PenlockState.full-share;
    property <[ShareRow]> rows: PenlockState.shares[root.share].rows;
    property <bool> long: root.rows.length > 12;
    background: Prime.surface;

    TouchArea {
        clicked => {
            PenlockState.full-share = -1;
        }
    }

    VerticalLayout {
        padding-top: Prime.status-bar;

        ScreenHeader {
            title: "Share \{root.share + 1}";
            trailing: "\{root.rows.length} rows";
            back => {
                PenlockState.full-share = -1;
            }
        }

        if !root.long: ShareGrid {
            rows: root.rows;
            box: 46px;
            gap: 8px;
        }

        if root.long: HorizontalLayout {
            alignment: center;

            ShareGrid {
                rows: root.rows;
                count: 12;
                box: 27px;
                gap: 4px;
            }

            ShareGrid {
                rows: root.rows;
                first: 12;
                count: root.rows.length - 12;
                box: 27px;
                gap: 4px;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Caption {
            text: "Tap anywhere to go back";
            horizontal-alignment: center;
        }

        Rectangle {
            height: 24px;
        }
    }
}

// A saved share is a file that outlives this screen, so saving is always a stated choice.
export component ShareSaveWarning inherits Rectangle {
    property <int> share: PenlockState.confirm-save;
    property <bool> second: PenlockState.saved-shares > 0;

    TouchArea { }

    Dialog {
        width: parent.width;
        height: parent.height;
        dismissable: false;
        fill-container: true;
        backdrop-color: Prime.scrim;
        panel-background: Prime.surface-raised;
        panel-border-color: root.second ? Prime.danger : Prime.line;
        panel-padding: 24px;
        border-radius: 24px;

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: root.second ? Prime.danger-soft : Prime.copper-soft;

                Icon {
                    source: Icons.alert;
                    tint: root.second ? Prime.danger : Prime.copper-ink;
                }
            }
        }

        Eyebrow {
            text: root.second ? "THIS CAN EXPOSE YOUR SEED" : "SAVED AS A FILE";
            color: root.second ? Prime.danger : Prime.copper;
        }

        Title {
            text: root.second ? "Save a second share here?" : "Save share \{root.share + 1} as an image?";
        }

        Body {
            text: root.second ? "Two shares in one place rebuild your seed phrase. Anyone who gets both can take your funds. Keep only one share on any device." : "It goes in the penlock folder and stays until you delete it. One share reveals nothing, but any two rebuild your phrase, so keep the others elsewhere.";
        }

        Action {
            height: 52px;
            text: root.second ? "Save anyway" : "Save image";
            clicked => {
                Callbacks.save-share(root.share);
                PenlockState.confirm-save = -1;
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Cancel";
            clicked => {
                PenlockState.confirm-save = -1;
            }
        }
    }
}

component ShareTab {
    in property <string> text;
    in property <bool> selected;
    in property <bool> viewed;
    callback clicked();
    height: 48px;

    Rectangle {
        border-radius: self.height / 2;
        background: root.selected ? Prime.copper-soft : transparent;
        border-width: root.selected ? 1px : 0;
        border-color: Prime.line-accent;

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            if root.viewed: VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.check;
                    tint: root.selected ? Prime.copper-ink : Prime.success;
                    size: 14px;
                }
            }

            Text {
                text: root.text;
                color: root.selected ? Prime.copper-ink : Prime.ink-muted;
                font-family: Prime.text-font;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ShareSheets inherits Screen {
    property <int> tab: 0;
    property <[bool]> copied: [false, false, false];
    property <int> copied-count: (root.copied[0] ? 1 : 0) + (root.copied[1] ? 1 : 0) + (root.copied[2] ? 1 : 0);
    // Marking this share copied finishes the job.
    property <bool> finishing: root.copied-count + (root.copied[root.tab] ? 0 : 1) == 3;

    // The next share still to copy, after this one.
    function next() -> int {
        return root.copied[mod(root.tab + 1, 3)] ? mod(root.tab + 2, 3) : mod(root.tab + 1, 3);
    }

    ScreenHeader {
        title: "Your shares";
        trailing: "\{root.copied-count} / 3 copied";
        done: root.copied-count == 3;
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        Rectangle {
            height: 58px;
            border-radius: self.height / 2;
            background: Prime.surface-sunken;
            border-width: 1px;
            border-color: Prime.line;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                ShareTab {
                    width: (root.width - 2 * Prime.gutter - 16px) / 3;
                    text: "Share 1";
                    selected: root.tab == 0;
                    viewed: root.copied[0];
                    clicked => {
                        root.tab = 0;
                    }
                }

                ShareTab {
                    width: (root.width - 2 * Prime.gutter - 16px) / 3;
                    text: "Share 2";
                    selected: root.tab == 1;
                    viewed: root.copied[1];
                    clicked => {
                        root.tab = 1;
                    }
                }

                ShareTab {
                    width: (root.width - 2 * Prime.gutter - 16px) / 3;
                    text: "Share 3";
                    selected: root.tab == 2;
                    viewed: root.copied[2];
                    clicked => {
                        root.tab = 2;
                    }
                }
            }
        }

        Rectangle {
            height: 16px;
        }

        HorizontalLayout {
            spacing: 12px;

            Label {
                horizontal-stretch: 1;
                text: "Copy onto its own strip, shaded boxes first.";
                wrap: no-wrap;
            }

            HorizontalLayout {
                spacing: 6px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Prime.line-accent;
                        background: Prime.copper-soft;
                    }
                }

                Caption {
                    text: "First";
                    color: Prime.ink-muted;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        Rectangle {
            height: 16px;
        }

        Rectangle {
            height: 1px;
            background: Prime.line;
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            Flickable {
                viewport-height: grid.preferred-height;

                TouchArea {
                    clicked => {
                        PenlockState.full-share = root.tab;
                    }
                }

                grid := ShareGrid {
                    rows: PenlockState.shares[root.tab].rows;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Prime.line;
        }

        Rectangle {
            height: 40px;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: Icons.chevron-down;
                        tint: Prime.copper-ink;
                        size: 14px;
                    }
                }

                Label {
                    text: "See all rows";
                    color: Prime.copper-ink;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            TouchArea {
                clicked => {
                    PenlockState.full-share = root.tab;
                }
            }
        }
    }

    Footer {
        spacing: 8px;

        Action {
            text: root.finishing ? "I've copied all three" : "I've copied share \{root.tab + 1}";
            has-icon: true;
            icon: Icons.check;
            clicked => {
                if root.finishing {
                    Callbacks.penlock-close();
                } else {
                    root.copied[root.tab] = true;
                    root.tab = root.next();
                }
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Save share \{root.tab + 1} as an image";
            has-icon: true;
            icon: Icons.download;
            clicked => {
                PenlockState.confirm-save = root.tab;
            }
        }
    }
}

// The corners of the scan frame: a rounded outline, with all but its corners cut away.
component FrameCorners {
    in property <color> tint;
    property <length> arm: 40px;

    for corner in [
        { right: false, bottom: false },
        { right: true, bottom: false },
        { right: false, bottom: true },
        { right: true, bottom: true },
    ]: Rectangle {
        x: corner.right ? root.width - root.arm : 0;
        y: corner.bottom ? root.height - root.arm : 0;
        width: root.arm;
        height: root.arm;
        clip: true;

        Rectangle {
            x: corner.right ? -root.arm : 0;
            y: corner.bottom ? -root.arm : 0;
            width: 2 * root.arm;
            height: 2 * root.arm;
            border-width: 3px;
            border-radius: 14px;
            border-color: root.tint;
        }
    }
}

component ShareTile {
    in property <string> name;
    in property <bool> read;
    in property <bool> disabled;
    callback clicked();
    height: 48px;
    opacity: root.disabled ? 0.4 : 1;

    Rectangle {
        y: 0;
        height: 2px;
        background: root.read ? Prime.success : Prime.line-strong;
    }

    VerticalLayout {
        alignment: start;
        padding-top: 10px;
        spacing: 2px;

        Text {
            text: root.name;
            color: Prime.ink;
            font-family: Prime.text-font;
            font-size: 14px;
            font-weight: 600;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 4px;

            if root.read: Icon {
                source: Icons.check;
                tint: Prime.success;
                size: 12px;
            }

            Caption {
                text: root.read ? "Read" : "Tap to upload";
                color: root.read ? Prime.success : Prime.copper-ink;
                font-weight: root.read ? 600 : 400;
            }
        }
    }

    TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.clicked();
        }
    }
}

export component ScanShares inherits Rectangle {
    background: Prime.surface;
    property <int> read-count: (PenlockState.have[0] ? 1 : 0) + (PenlockState.have[1] ? 1 : 0) + (PenlockState.have[2] ? 1 : 0);
    property <bool> phrase: PenlockState.scan-phrase;
    property <bool> qr: PenlockState.scan-qr;
    property <bool> scanned-one: root.read-count > 0;

    ScreenHeader {
        y: Prime.status-bar;
        width: parent.width;
        title: root.qr ? PenlockState.scan-title : root.phrase ? "Read a written phrase" : "Restore from shares";
        back => {
            if root.qr {
                Callbacks.scan-qr-cancel();
            } else {
                Callbacks.penlock-close();
            }
        }
    }

    viewfinder := Rectangle {
        x: Prime.gutter;
        y: PenlockState.viewfinder-y;
        width: parent.width - 2 * Prime.gutter;
        height: 380px;
        border-radius: 24px;
        background: Prime.surface-sunken;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: PenlockState.preview;
            image-fit: cover;
        }

        // A share strip is tall and narrow: frame it that way. A phrase fills the page.
        FrameCorners {
            x: root.phrase ? 24px : root.qr ? 66px : 106px;
            y: root.phrase || root.qr ? 32px : 40px;
            width: parent.width - 2 * self.x;
            height: parent.height - self.y - (root.phrase || root.qr ? 64px : 60px);
            tint: PenlockState.scan-hit ? Prime.success : Prime.ink;
        }

        Rectangle {
            y: parent.height - self.height - 14px;
            height: 32px;
            width: min(parent.width - 2 * Prime.gutter, status.preferred-width);
            border-radius: self.height / 2;
            background: PenlockState.scan-hit ? Prime.success-soft : Prime.surface-raised;
            border-width: 1px;
            border-color: PenlockState.scan-hit ? Prime.success : Prime.line;

            status := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                if PenlockState.scan-hit: VerticalLayout {
                    alignment: center;

                    Icon {
                        source: Icons.check;
                        tint: Prime.success;
                        size: 16px;
                    }
                }

                if !PenlockState.scan-hit: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Prime.copper;
                    }
                }

                Text {
                    text: PenlockState.scan-status;
                    color: PenlockState.scan-hit ? Prime.success : Prime.ink;
                    font-family: Prime.text-font;
                    font-size: 14px;
                    font-weight: PenlockState.scan-hit ? 600 : 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    VerticalLayout {
        x: Prime.gutter;
        y: viewfinder.y + viewfinder.height + 24px;
        width: parent.width - 2 * Prime.gutter;
        height: parent.height - self.y - 32px;
        spacing: 12px;

        if root.qr: Note {
            icon: Icons.frame;
            text: "Hold the code steady and fill the frame.";
        }

        if !root.qr: HorizontalLayout {
            Eyebrow {
                horizontal-stretch: 1;
                text: root.phrase ? "WORDS READ" : "SHARES READ";
            }

            Code {
                text: root.phrase ? "\{PenlockState.words-read}" : "\{root.read-count} of 2";
                color: root.phrase && PenlockState.draft-complete ? Prime.success : Prime.ink;
            }
        }

        if !root.phrase && !root.qr: HorizontalLayout {
            spacing: 16px;

            for i in 3: ShareTile {
                width: (root.width - 2 * Prime.gutter - 32px) / 3;
                name: "Share \{i + 1}";
                read: PenlockState.have[i];
                disabled: PenlockState.photo-reading || !PenlockState.reader-ready;
                clicked => {
                    Callbacks.upload-share(i);
                }
            }
        }

        if PenlockState.scan-error != "": Label {
            text: PenlockState.scan-error;
            color: PenlockState.scan-failed ? Prime.danger : Prime.ink-muted;
        }

        if !root.phrase && !root.qr && PenlockState.scan-error == "" && !(root.scanned-one && PenlockState.scan-for-wallet): Label {
            text: root.scanned-one ? "Now add any other strip: tap a share, or take a photo." : "Tap a share to upload a strip, or take a photo. Any two work, in any order.";
        }

        if root.phrase && PenlockState.scan-error == "" && !PenlockState.draft-ready: VerticalLayout {
            spacing: 10px;

            Note {
                icon: Icons.frame;
                text: "Fill the frame with your written words, then take a photo.";
            }

            Note {
                icon: Icons.sun;
                text: "Use good, even light.";
            }
        }

        if root.phrase && PenlockState.scan-error == "" && PenlockState.draft-ready: Label {
            text: "Next, check every word against your paper before you use them.";
        }

        Rectangle {
            vertical-stretch: 1;
        }

        if !root.qr && !PenlockState.draft-ready: HorizontalLayout {
            spacing: 12px;

            Action {
                width: root.phrase ? (root.width - 2 * Prime.gutter - 12px) / 2 : root.width - 2 * Prime.gutter;
                height: 52px;
                text: PenlockState.photo-reading ? "Reading…" : "Take photo";
                disabled: PenlockState.photo-reading || !PenlockState.reader-ready;
                has-icon: !PenlockState.photo-reading;
                icon: Icons.scan;
                clicked => {
                    Callbacks.take-photo();
                }
            }

            if root.phrase: Action {
                width: (root.width - 2 * Prime.gutter - 12px) / 2;
                height: 52px;
                kind: ActionKind.secondary;
                text: "Upload photo";
                disabled: PenlockState.photo-reading || !PenlockState.reader-ready;
                has-icon: true;
                icon: Icons.upload;
                clicked => {
                    Callbacks.upload-photo();
                }
            }
        }

        if !root.phrase && !root.qr && PenlockState.scan-for-wallet && PenlockState.can-sign-share: Action {
            height: 48px;
            kind: ActionKind.secondary;
            text: "Sign with share \{PenlockState.read-share}";
            has-icon: true;
            icon: Icons.pen;
            clicked => {
                Callbacks.sign-with-scanned();
            }
        }

        if root.phrase && PenlockState.draft-ready: VerticalLayout {
            spacing: 8px;

            Action {
                text: "Review \{PenlockState.words-read} words";
                has-icon: true;
                icon-after: true;
                icon: Icons.arrow-right;
                clicked => {
                    Callbacks.review-draft();
                }
            }

            Action {
                kind: ActionKind.tertiary;
                text: "Choose another photo";
                clicked => {
                    Callbacks.retake-photo();
                }
            }
        }
    }
}

component RevealedWord {
    in property <int> number;
    in property <string> word;
    height: 32px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Prime.surface-raised;
    }

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: 20px;
            text: root.number;
            color: Prime.ink-faint;
            font-family: Prime.mono-font;
            font-size: 12px;
            vertical-alignment: center;
        }

        Code {
            horizontal-stretch: 1;
            text: root.word;
            font-size: 16px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A hairline, then the space below it, opening a section.
component SectionRule inherits VerticalLayout {
    in property <length> below: 16px;

    Rectangle {
        height: 1px;
        background: Prime.line;
    }

    Rectangle {
        height: root.below;
    }
}

export component Recovered inherits Screen {
    property <bool> revealed;
    property <int> half: floor((PenlockState.words.length + 1) / 2);
    property <bool> recheck: PenlockState.corrections.length > 0;
    property <string> corrections: PenlockState.corrections[0] + (PenlockState.corrections.length > 1 ? "\n" + PenlockState.corrections[1] : "") + (PenlockState.corrections.length > 2 ? "\n…and \{PenlockState.corrections.length - 2} more" : "");

    ScreenHeader {
        title: "Phrase recovered";
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        padding-top: root.revealed ? 16px : 24px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.check;
                    tint: Prime.success;
                    size: 14px;
                }
            }

            Eyebrow {
                text: root.revealed ? "RECOVERED · \{PenlockState.words.length} WORDS" : "RECOVERED";
                color: Prime.success;
            }
        }

        if !root.revealed: Rectangle {
            height: 8px;
        }

        if !root.revealed: Display {
            text: "\{PenlockState.words.length} words";
        }

        Rectangle {
            height: root.revealed ? 4px : 8px;
        }

        Label {
            text: PenlockState.result-subtitle;
        }

        Rectangle {
            height: root.revealed ? 16px : 24px;
        }

        if root.recheck && !root.revealed: SectionRule { }

        if root.recheck && !root.revealed: HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;

                Icon {
                    source: Icons.alert;
                    tint: Prime.warning;
                    size: 14px;
                }
            }

            Eyebrow {
                text: "RECHECK ON PAPER";
                color: Prime.warning;
            }
        }

        if root.recheck && !root.revealed: Rectangle {
            height: 8px;
        }

        if root.recheck && !root.revealed: Body {
            text: root.corrections;
            color: Prime.ink;
        }

        if root.recheck && !root.revealed: Rectangle {
            height: 24px;
        }

        if root.recheck && root.revealed: SectionRule {
            below: 12px;
        }

        if root.recheck && root.revealed: HorizontalLayout {
            spacing: 8px;

            Icon {
                source: Icons.alert;
                tint: Prime.warning;
                size: 16px;
            }

            VerticalLayout {
                horizontal-stretch: 1;

                Label {
                    text: "Recheck on paper:";
                    color: Prime.warning;
                    font-weight: 600;
                }

                Label {
                    text: root.corrections;
                    color: Prime.ink;
                }
            }
        }

        if root.recheck && root.revealed: Rectangle {
            height: 12px;
        }

        SectionRule {
            below: root.revealed ? 0 : 16px;
        }

        HorizontalLayout {
            height: root.revealed ? 48px : 16px;

            Eyebrow {
                horizontal-stretch: 1;
                text: "YOUR PHRASE";
                vertical-alignment: center;
            }

            if !root.revealed: Caption {
                text: "Hidden";
                vertical-alignment: center;
                wrap: no-wrap;
            }

            if root.revealed: Rectangle {
                width: 80px;

                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            source: Icons.eye-off;
                            tint: Prime.copper-ink;
                            size: 16px;
                        }
                    }

                    Label {
                        text: "Hide";
                        color: Prime.copper-ink;
                        font-weight: 600;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                }

                TouchArea {
                    clicked => {
                        root.revealed = false;
                    }
                }
            }
        }

        if !root.revealed: VerticalLayout {
            padding-top: 16px;
            spacing: 8px;

            SlideToConfirm {
                height: 64px;
                thumb-width: 54px;
                hint: "Slide to show phrase";
                label: "";
                confirmed-label: "";
                control-height: 64px;
                border-radius: 32px;
                thumb-border-radius: 27px;
                track-color: Prime.surface-sunken;
                track-border-color: Prime.line-strong;
                label-color: Prime.ink-muted;
                thumb-color: Prime.copper;
                thumb-label-color: Prime.on-copper;
                font-family: Prime.text-font;
                activated => {
                    root.revealed = true;
                }
            }

            Caption {
                text: "Make sure no one can see your screen.";
            }
        }

        if root.revealed: Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Prime.surface-sunken;
            clip: true;

            Flickable {
                viewport-height: word-list.preferred-height;

                // Column-major, like a recovery card: 1–6 on the left, 7–12 on the right.
                word-list := VerticalLayout {
                    alignment: start;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 4px;

                    for r in root.half: HorizontalLayout {
                        spacing: 24px;

                        RevealedWord {
                            width: (root.width - 2 * Prime.gutter - 56px) / 2;
                            number: r + 1;
                            word: PenlockState.words[r];
                        }

                        RevealedWord {
                            width: (root.width - 2 * Prime.gutter - 56px) / 2;
                            visible: r + root.half < PenlockState.words.length;
                            number: r + root.half + 1;
                            word: PenlockState.words[r + root.half];
                        }
                    }
                }
            }
        }

        if !root.revealed: Rectangle {
            vertical-stretch: 1;
        }
    }

    Footer {
        Action {
            text: "Sign a transaction";
            clicked => {
                Callbacks.seed-sign("");
            }
        }

        Action {
            kind: ActionKind.secondary;
            text: "Sign with cosigners";
            clicked => {
                Callbacks.wallet-from-recovered();
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Done";
            clicked => {
                Callbacks.penlock-close();
            }
        }
    }
}
