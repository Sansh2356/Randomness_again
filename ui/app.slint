import {
    Theme,
    UISize,
    Images,
    ControlSize,
} from "@ui/theme.slint";
import { ToastVariant } from "@ui/toast.slint";
import {
    AddressChunk,
    AddressRow,
    Callbacks,
    AppState,
    ChipRow,
    PenlockState,
    PenlockScreen,
    PhraseStatus,
    PhraseWord,
    QrKind,
    SendRow,
    ShareRow,
    ShareSheet,
    WalletState,
} from "callbacks.slint";
import { Notice, Prime } from "common.slint";
import { SeedWarning, PenlockHome, EnterPhrase, ShareSheets, ScanShares, Recovered } from "penlock.slint";
import { WalletLoad, WalletHome, WalletQr, WalletInput, WalletReview } from "wallet.slint";

export {
    AddressChunk,
    AddressRow,
    Callbacks,
    AppState,
    ChipRow,
    PenlockState,
    PenlockScreen,
    PhraseStatus,
    PhraseWord,
    QrKind,
    SendRow,
    ShareRow,
    ShareSheet,
    WalletState,
    Theme,
    Images,
    ControlSize,
    ToastVariant,
}

export component AppWindow inherits Window {
    title: "Penlock";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Prime.surface;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Prime.surface;

        PenlockHome { }
    }

    // Flows pushed over the home. Each is opaque and takes the whole screen.
    if PenlockState.screen != PenlockScreen.home: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Prime.surface;

        // Swallow touches meant for the home underneath.
        TouchArea { }

        if PenlockState.screen == PenlockScreen.enter: EnterPhrase { }
        if PenlockState.screen == PenlockScreen.shares: ShareSheets { }
        if PenlockState.screen == PenlockScreen.scan: ScanShares {
            width: parent.width;
            height: parent.height;
        }
        if PenlockState.screen == PenlockScreen.result: Recovered { }
        if PenlockState.screen == PenlockScreen.wallet-load: WalletLoad { }
        if PenlockState.screen == PenlockScreen.wallet: WalletHome { }
        if PenlockState.screen == PenlockScreen.wallet-qr: WalletQr { }
        if PenlockState.screen == PenlockScreen.wallet-input: WalletInput { }
        if PenlockState.screen == PenlockScreen.wallet-review: WalletReview { }
    }

    if !PenlockState.warning-accepted: SeedWarning {
        width: parent.width;
        height: parent.height;
    }

    // Above the bottom action, and gone on their own.
    Timer {
        interval: 4s;
        running: AppState.toast != "";
        triggered => {
            Callbacks.dismiss-toast();
        }
    }

    if AppState.toast != "": Notice {
        x: Prime.gutter;
        y: parent.height - 100px - self.min-height;
        width: parent.width - 2 * Prime.gutter;
        message: AppState.toast;
        detail: AppState.toast-detail;
        variant: AppState.toast-variant;
        dismissed => {
            Callbacks.dismiss-toast();
        }
    }
}
