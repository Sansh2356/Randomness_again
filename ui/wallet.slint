import { Dialog } from "@ui/dialog.slint";
import { SlideToConfirm } from "@ui/slide_to_confirm.slint";
import { TextArea } from "@ui/textarea.slint";
import { AddressRow, Callbacks, QrKind, WalletState } from "callbacks.slint";
import {
    Action,
    ActionKind,
    Body,
    Caption,
    Code,
    Content,
    Display,
    Eyebrow,
    Footer,
    Heading,
    Icon,
    IconTile,
    Icons,
    Label,
    NavCard,
    Note,
    Prime,
    Screen,
    ScreenHeader,
    ValueWell,
} from "common.slint";

// Real bitcoin is a choice someone makes on purpose, knowing what backs it.
export component MainnetWarning inherits Rectangle {
    // Dialog only blocks touches on its backdrop when it's dismissable.
    TouchArea { }

    Dialog {
        width: parent.width;
        height: parent.height;
        dismissable: false;
        fill-container: true;
        backdrop-color: Prime.scrim;
        panel-background: Prime.surface-raised;
        panel-border-color: Prime.danger;
        panel-padding: 24px;
        border-radius: 24px;

        HorizontalLayout {
            alignment: start;

            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Prime.danger-soft;

                Icon {
                    source: Icons.alert;
                    tint: Prime.danger;
                }
            }
        }

        Eyebrow {
            text: "REAL BITCOIN";
            color: Prime.danger;
        }

        Text {
            text: "Use mainnet?";
            color: Prime.ink;
            font-family: Prime.display-font;
            font-size: 24px;
            font-weight: 600;
        }

        Body {
            text: "This signing code hasn't been audited. A mistake or a bug can lose your bitcoin for good. Only use a new seed, with an amount you can afford to lose.";
        }

        Action {
            height: 52px;
            text: "Use mainnet";
            clicked => {
                WalletState.mainnet = true;
                WalletState.confirm-mainnet = false;
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Stay on signet";
            clicked => {
                WalletState.confirm-mainnet = false;
            }
        }
    }
}

component Toggle {
    in property <bool> on;
    in property <bool> disabled;
    callback toggled();
    width: 56px;
    height: 32px;
    opacity: root.disabled ? 0.4 : 1;

    Rectangle {
        border-radius: self.height / 2;
        background: root.on ? Prime.copper : Prime.surface-sunken;
        border-width: root.on ? 0 : 1px;
        border-color: Prime.line-strong;

        Rectangle {
            x: root.on ? parent.width - self.width - 4px : 4px;
            y: 4px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: root.on ? Prime.on-copper : Prime.ink-muted;
        }
    }

    TouchArea {
        enabled: !root.disabled;
        clicked => {
            root.toggled();
        }
    }
}

export component AppSettings inherits Screen {
    ScreenHeader {
        title: "Settings";
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        spacing: 12px;

        Eyebrow {
            text: "NETWORK";
        }

        Rectangle {
            border-radius: 12px;
            background: WalletState.mainnet ? Prime.danger-soft : Prime.surface-raised;
            border-width: 1px;
            border-color: WalletState.mainnet ? Prime.danger : Prime.line;
            height: network.preferred-height;

            network := HorizontalLayout {
                padding: 16px;
                spacing: 16px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Heading {
                        text: "Mainnet";
                    }

                    Label {
                        text: WalletState.mainnet ? "On. New keys use real bitcoin." : "Off. New keys use signet test coins.";
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        on: WalletState.mainnet;
                        disabled: WalletState.loaded;
                        toggled => {
                            if WalletState.mainnet {
                                WalletState.mainnet = false;
                            } else {
                                WalletState.confirm-mainnet = true;
                            }
                        }
                    }
                }
            }
        }

        if WalletState.loaded: Note {
            icon: Icons.lock;
            tint: Prime.warning;
            text: "Lock the signer to change network. Each network has its own keys.";
        }

        if WalletState.mainnet: Note {
            icon: Icons.alert;
            tint: Prime.danger;
            text: "This signing code hasn't been audited. Use a new seed and an amount you can afford to lose.";
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

// Where the signing key comes from.
export component WalletLoad inherits Screen {
    ScreenHeader {
        title: "Sign a transaction";
        network: WalletState.mainnet ? "MAINNET" : "SIGNET";
        caution: WalletState.mainnet;
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        spacing: 12px;

        Body {
            text: "Choose what this Passport signs with. Your wallet builds the PSBT and broadcasts the result.";
        }

        Rectangle {
            height: 12px;
        }

        NavCard {
            lead: true;
            icon: Icons.seed;
            title: "Seed phrase";
            subtitle: "Scan or type it, then import a PSBT";
            clicked => {
                Callbacks.penlock-read-phrase();
            }
        }

        NavCard {
            icon: Icons.shares;
            title: "Two Penlock shares";
            subtitle: "Rebuild the seed, then import a PSBT";
            clicked => {
                Callbacks.penlock-scan();
            }
        }

        NavCard {
            icon: Icons.one-share;
            title: "One Penlock share";
            subtitle: "Another device signs with another share";
            clicked => {
                Callbacks.wallet-scan-share();
            }
        }

        if WalletState.simulator: VerticalLayout {
            padding-top: 20px;
            spacing: 12px;

            Eyebrow {
                text: "TESTING";
            }

            NavCard {
                icon: Icons.paste;
                title: "Paste a share";
                test-only: true;
                clicked => {
                    Callbacks.wallet-paste-share();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

export component WalletHome inherits Screen {
    property <bool> ready: WalletState.cosigners > 0;

    ScreenHeader {
        title: "MuSig signer";
        network: WalletState.mainnet ? "MAINNET" : "SIGNET";
        caution: WalletState.mainnet;
        back => {
            Callbacks.penlock-close();
        }
    }

    Content {
        padding-top: 24px;

        Eyebrow {
            text: "\{WalletState.source} · YOUR KEY";
        }

        Rectangle {
            height: 8px;
        }

        Display {
            text: root.ready ? "\{WalletState.cosigners + 1}-of-\{WalletState.cosigners + 1} MuSig2" : "No cosigners yet";
        }

        Rectangle {
            height: 8px;
        }

        Label {
            text: !root.ready ? "Check this key matches your setup." : WalletState.cosigners == 1 ? "You and 1 cosigner. Check this key matches your setup." : "You and \{WalletState.cosigners} cosigners. Check this key matches your setup.";
        }

        Rectangle {
            height: 16px;
        }

        ValueWell {
            label: "Fingerprint";
            value: WalletState.fingerprint;
        }

        Rectangle {
            height: 24px;
        }

        VerticalLayout {
            spacing: 10px;

            if root.ready: NavCard {
                compact: true;
                lead: true;
                icon: Icons.sign;
                title: "Sign a transaction";
                subtitle: "Scan a PSBT";
                clicked => {
                    Callbacks.wallet-sign();
                }
            }

            if root.ready: NavCard {
                compact: true;
                icon: Icons.receive;
                title: "Receive";
                subtitle: "Show a shared address";
                clicked => {
                    Callbacks.wallet-receive();
                }
            }

            NavCard {
                compact: true;
                lead: !root.ready;
                icon: Icons.user;
                title: "Show my key";
                subtitle: "For your cosigners to add";
                clicked => {
                    Callbacks.wallet-show-key();
                }
            }

            NavCard {
                compact: true;
                icon: Icons.user-plus;
                title: "Add a cosigner";
                subtitle: "Scan their account key";
                clicked => {
                    Callbacks.wallet-add-cosigner();
                }
            }

            if !root.ready: NavCard {
                compact: true;
                disabled: true;
                icon: Icons.receive;
                title: "Receive";
                subtitle: "Add a cosigner first";
            }

            if !root.ready: NavCard {
                compact: true;
                disabled: true;
                icon: Icons.sign;
                title: "Sign a transaction";
                subtitle: "Add a cosigner first";
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }

    Footer {
        Action {
            kind: ActionKind.secondary;
            text: "Lock signer";
            has-icon: true;
            icon: Icons.lock-wallet;
            clicked => {
                Callbacks.wallet-lock();
            }
        }
    }
}

// An address in groups of four, its two ends picked out.
component AddressWell {
    in property <[AddressRow]> rows;
    height: list.preferred-height;

    Rectangle {
        border-radius: 8px;
        background: Prime.surface-sunken;
    }

    list := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 2px;

        for row in root.rows: HorizontalLayout {
            alignment: start;
            spacing: 10px;

            for chunk in row.chunks: Code {
                text: chunk.text;
                font-size: 16px;
                color: chunk.hot ? Prime.copper-ink : Prime.ink-muted;
                font-weight: chunk.hot ? 500 : 400;
            }
        }
    }
}

component Step {
    in property <string> text;
    in property <bool> done;
    in property <bool> current;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: root.done ? Prime.success : root.current ? Prime.copper : Prime.line;
        }

        Text {
            text: root.text;
            color: root.done ? Prime.success : root.current ? Prime.copper-ink : Prime.ink-faint;
            font-family: Prime.text-font;
            font-size: 12px;
            font-weight: root.done || root.current ? 600 : 400;
        }
    }
}

// Anything leaving the Passport: a key, an address, a PSBT.
export component WalletQr inherits Screen {
    property <QrKind> kind: WalletState.qr-kind;
    property <bool> signing: root.kind != QrKind.key && root.kind != QrKind.address;
    // A rebuilt seed signs alone, so there are no rounds to show.
    property <bool> stepped: root.signing && root.kind != QrKind.single-tx;
    property <length> code-size: root.kind == QrKind.key ? 320px : root.kind == QrKind.address ? 296px : 304px;

    ScreenHeader {
        title: root.kind == QrKind.key ? "My key" : root.kind == QrKind.address ? "Receive" : "Sign transaction";
        trailing: root.kind == QrKind.address ? WalletState.qr-title : "";
        back => {
            Callbacks.wallet-back();
        }
    }

    Content {
        if root.stepped: HorizontalLayout {
            spacing: 8px;

            Step {
                horizontal-stretch: 1;
                text: root.kind == QrKind.nonces ? "1 · Nonces" : "Nonces";
                current: root.kind == QrKind.nonces;
                done: root.kind != QrKind.nonces;
            }

            Step {
                horizontal-stretch: 1;
                text: root.kind == QrKind.final-tx ? "Sign" : "2 · Sign";
                current: root.kind == QrKind.partial;
                done: root.kind == QrKind.final-tx;
            }

            Step {
                horizontal-stretch: 1;
                text: "3 · Broadcast";
                current: root.kind == QrKind.final-tx;
            }
        }

        if root.stepped: Rectangle {
            height: 16px;
        }

        // White in both themes so any camera can read the code.
        Rectangle {
            height: root.code-size + 2 * (root.signing ? 20px : 24px);
            border-radius: 24px;
            background: white;

            Image {
                width: root.code-size;
                height: root.code-size;
                source: WalletState.qr;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }

        Rectangle {
            height: 16px;
        }

        if root.kind == QrKind.key: VerticalLayout {
            spacing: 16px;

            ValueWell {
                label: "Fingerprint";
                value: WalletState.fingerprint;
            }

            Note {
                icon: Icons.info;
                tint: Prime.success;
                text: WalletState.qr-caption;
            }
        }

        if root.kind == QrKind.address: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                Eyebrow {
                    horizontal-stretch: 1;
                    text: "SHARED ADDRESS";
                }

                Caption {
                    text: "\{WalletState.mainnet ? "Mainnet" : "Signet"} · \{WalletState.cosigners + 1}-of-\{WalletState.cosigners + 1}";
                    wrap: no-wrap;
                }
            }

            AddressWell {
                rows: WalletState.address-rows;
            }
        }

        if root.signing: VerticalLayout {
            spacing: 4px;

            Eyebrow {
                text: root.kind == QrKind.nonces ? "ROUND 1 OF 2" : root.kind == QrKind.partial ? "PARTIAL SIGNATURE" : "FULLY SIGNED";
                color: root.kind == QrKind.final-tx || root.kind == QrKind.single-tx ? Prime.success : Prime.copper;
            }

            Body {
                text: WalletState.qr-caption;
                color: Prime.ink;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }

    Footer {
        if root.kind == QrKind.address: Action {
            kind: ActionKind.secondary;
            text: "Next address";
            has-icon: true;
            icon-after: true;
            icon: Icons.arrow-right;
            clicked => {
                Callbacks.wallet-next-address();
            }
        }

        if root.kind == QrKind.nonces || root.kind == QrKind.partial: Action {
            text: root.kind == QrKind.nonces ? "Scan their PSBT" : "Scan the signed PSBT";
            has-icon: true;
            icon: Icons.scan;
            clicked => {
                Callbacks.wallet-sign();
            }
        }

        if root.kind == QrKind.nonces || root.kind == QrKind.partial: Action {
            kind: ActionKind.tertiary;
            text: "Done for now";
            clicked => {
                Callbacks.wallet-back();
            }
        }

        if root.kind != QrKind.nonces && root.kind != QrKind.partial: Action {
            text: "Done";
            clicked => {
                Callbacks.wallet-back();
            }
        }
    }
}

// The simulator has no one to hold a QR code up to its camera, so text can be pasted in instead.
export component WalletInput inherits Screen {
    ScreenHeader {
        title: WalletState.input-title;
        trailing: "Simulator only";
        pill: true;
        pill-caution: true;
        back => {
            Callbacks.wallet-back();
        }
    }

    Content {
        spacing: 8px;

        Label {
            text: "Paste";
            font-weight: 500;
        }

        TextArea {
            vertical-stretch: 0;
            height: 120px;
            field-min-height: 120px;
            disable-autosize: true;
            placeholder: "Paste the text";
            value <=> WalletState.input;
            background: Prime.surface-sunken;
            foreground: Prime.ink;
            placeholder-color: Prime.ink-faint;
            border-color: Prime.line-strong;
            border-radius: 8px;
            font-family: Prime.mono-font;
            font-size: 14px;
        }

        Caption {
            text: "For testing in the simulator. On a Passport, scan a QR code instead.";
        }

        // Under the field, because the keyboard covers the bottom of the screen.
        Rectangle {
            height: 4px;
        }

        Action {
            text: "Use this";
            disabled: WalletState.input == "";
            clicked => {
                Callbacks.wallet-submit(WalletState.input);
            }
        }

        Action {
            kind: ActionKind.secondary;
            text: "Scan a QR code";
            has-icon: true;
            icon: Icons.qr;
            clicked => {
                Callbacks.wallet-scan();
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component ReviewRow {
    in property <string> label;
    in property <string> amount;
    in property <bool> last;
    height: 52px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;

        Label {
            horizontal-stretch: 1;
            text: root.label;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        Code {
            text: root.amount;
            vertical-alignment: center;
        }
    }

    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Prime.line;
    }
}

export component WalletReview inherits Screen {
    ScreenHeader {
        title: "Review transaction";
        back => {
            Callbacks.wallet-cancel();
        }
    }

    Content {
        Flickable {
            vertical-stretch: 1;
            viewport-height: review.preferred-height;

            review := VerticalLayout {
                alignment: start;
                spacing: 8px;

                Eyebrow {
                    text: WalletState.mainnet ? "YOU'RE SENDING REAL BITCOIN" : "YOU'RE SENDING";
                    color: WalletState.mainnet ? Prime.danger : Prime.copper;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;

                    // Long totals drop a size: every digit has to stay on screen.
                    Text {
                        text: WalletState.send-total;
                        color: Prime.ink;
                        font-family: Prime.display-font;
                        font-size: WalletState.send-total-long ? 40px : 56px;
                        font-weight: 300;
                    }

                    Text {
                        text: "sats";
                        color: Prime.ink-muted;
                        font-family: Prime.text-font;
                        font-size: 16px;
                        vertical-alignment: bottom;
                    }
                }

                for send in WalletState.sends: VerticalLayout {
                    spacing: 8px;

                    Label {
                        text: WalletState.sends.length > 1 ? "To, \{send.amount} sats" : "To";
                        font-weight: 500;
                    }

                    AddressWell {
                        rows: send.rows;
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Rectangle {
                    height: 104px;
                    border-radius: 12px;
                    background: Prime.surface-raised;
                    border-width: 1px;
                    border-color: Prime.line;

                    VerticalLayout {
                        ReviewRow {
                            label: "Change, back to you";
                            amount: "\{WalletState.change} sats";
                        }

                        ReviewRow {
                            label: "Network fee";
                            amount: "\{WalletState.fee} sats";
                            last: true;
                        }
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Note {
                    icon: Icons.alert;
                    tint: Prime.warning;
                    text: "Check the address against the one you meant to pay, not just the highlighted ends.";
                    text-color: Prime.ink;
                }
            }
        }
    }

    Footer {
        spacing: 8px;

        SlideToConfirm {
            height: 64px;
            thumb-width: 54px;
            hint: WalletState.mainnet ? "Slide to sign real bitcoin" : "Slide to approve";
            label: "";
            confirmed-label: "";
            control-height: 64px;
            border-radius: 32px;
            thumb-border-radius: 27px;
            track-color: Prime.surface-sunken;
            track-border-color: Prime.line-strong;
            label-color: Prime.ink-muted;
            thumb-color: Prime.copper;
            thumb-label-color: Prime.on-copper;
            font-family: Prime.text-font;
            activated => {
                Callbacks.wallet-approve();
            }
        }

        Action {
            kind: ActionKind.tertiary;
            text: "Cancel";
            clicked => {
                Callbacks.wallet-cancel();
            }
        }
    }
}
